@namespace Lattice
@using Flare.Components
@using Flare.Components.IDE
@using Flare.Icons
@implements IDisposable
@inject LatticePluginCatalog Catalog
@inject ILatticeDocumentService Documents
@inject ILatticeToolWindowService ToolWindows
@inject ILatticeCommandService Commands
@inject ILatticeLocalizer Localizer
@inject ILatticeContext State
@inject ILatticeIconResolver Icons
@inject IServiceProvider Services

<FlareIdeLayout Documents="@IdeDocuments"
                ActiveDocuments="@ActiveDocuments"
                Height="100%"
                LeftPanelWidth="270px"
                RightPanelWidth="280px"
                BottomPanelHeight="150px"
                DocumentMounting="IdeDocumentMounting.ActiveOnly"
                LeftRegionVisible="@HasLeftRegion"
                RightRegionVisible="@HasRightRegion"
                LeftToolPanel="@LeftTools"
                RightToolPanel="@RightTools"
                Ribbon="@RibbonContent"
                MenuBar="@MenuBarContent"
                ChildContent="@StartSurfaceContent"
                BottomPanel="@BottomPanelSurface"
                BottomHeaderContent="@BottomHeaderSurface"
                ShowBottomHeader="@(ShellContent(LatticeShellSlot.BottomHeader) is not null)"
                ShowBottomPin="true"
                ShowBottomCollapse="false"
                BottomPinned="@_bottomPinned"
                BottomPinnedChanged="OnBottomPinnedChanged"
                StatusBar="@StatusBarContent"
                OnActiveDocumentChanged="OnActiveDocumentChanged"
                OnDocumentCloseRequested="OnDocumentCloseRequested"
                OnDocumentMove="OnDocumentMove">
    <CenterDockHeader>
        <div class="q-main-tabs">
            <FlareDocumentTabs StripOnly="true"
                               ControlledSelection="true"
                               ActiveKey="@ActiveCenterKey"
                               ActiveKeyChanged="OnTabActivated"
                               OnCloseRequested="OnTabCloseRequested">
                <ContextMenuContent Context="key">
                    <FlareMenuItem OnClick="() => CloseTab(key)">@Localizer.Get(LatticeHostPlugin.Key("close"))</FlareMenuItem>
                    <FlareMenuItem OnClick="CloseAllTabs">@Localizer.Get(LatticeHostPlugin.Key("closeAll"))</FlareMenuItem>
                    <FlareMenuItem OnClick="() => CloseOtherTabs(key)">@Localizer.Get(LatticeHostPlugin.Key("closeOthers"))</FlareMenuItem>
                </ContextMenuContent>
                <ChildContent>
                    @foreach (var document in MainDocuments)
                    {
                        <FlareDocumentTab @key="document.Id"
                                          Key="@document.Id"
                                          Title="@Localizer.Get(document.Title)"
                                          Icon="@DocumentIcon(document)"
                                          Closeable="true" />
                    }
                </ChildContent>
            </FlareDocumentTabs>
        </div>
    </CenterDockHeader>

    <DocumentContent Context="document">@RenderDocument(document)</DocumentContent>
</FlareIdeLayout>

@code {
    private IReadOnlyList<ToolbarDescriptor> Toolbars =>
        Catalog.Toolbars
            .OrderBy(toolbar => toolbar.Order)
            .ThenBy(toolbar => toolbar.Id.Value, StringComparer.Ordinal)
            .ToArray();

    private RenderFragment? RibbonContent =>
        Toolbars.Count > 0 ? null : @<FlareRibbon>
            <FlareRibbonTab Title="@RibbonTitle">
                @foreach (var group in RibbonGroups)
                {
                    <FlareRibbonGroup @key="group.Id.Value" Label="@Localizer.Get(group.Title)">
                        @foreach (var item in ItemsFor(group.Id))
                        {
                            var command = FindCommand(item.Command);
                            <FlareRibbonButton @key="item.Id.Value"
                                               Icon="@Icons.Resolve(item.IconKey ?? command?.IconKey)"
                                               Label="@CommandLabel(item.Command)"
                                               Tooltip="@CommandLabel(item.Command)"
                                               Disabled="@(!Commands.CanExecute(item.Command))"
                                               OnClick="() => ExecuteAsync(item.Command)" />
                        }
                    </FlareRibbonGroup>
                }
            </FlareRibbonTab>
        </FlareRibbon>;

    private RenderFragment MenuBarContent => @<text>
        @if (ShellContent(LatticeShellSlot.MenuBar) is { } shellMenuBar)
        {
            <DynamicComponent @key="shellMenuBar.Id.Value" Type="@shellMenuBar.Component" />
        }
        else if (MenuBar is not null)
        {
            @MenuBar
        }
        else
        {
            <FlareMenuBar>
                @foreach (var group in MenuGroups)
                {
                    <FlareMenu @key="group.Id.Value"
                               Anchor="MenuAnchor.BottomLeft"
                               AriaLabel="@Localizer.Get(group.Title)">
                        <Activator>
                            <FlareButton Variant="ButtonVariant.Text"
                                         Size="ButtonSize.Sm"
                                         @attributes="context.Attributes">@Localizer.Get(group.Title)</FlareButton>
                        </Activator>
                        <ChildContent>
                            @foreach (var item in ItemsFor(group.Id))
                            {
                                <LatticeMenuEntry Item="item" />
                            }
                        </ChildContent>
                    </FlareMenu>
                }
            </FlareMenuBar>
        }
        @foreach (var toolbar in Toolbars)
        {
            <DynamicComponent @key="toolbar.Id.Value"
                              Type="@toolbar.Component"
                              Parameters="@(new Dictionary<string, object?>
                              {
                                  [nameof(LatticeToolbarComponent.Context)] = ToolbarContext
                              })" />
        }
    </text>;

    private LatticeToolbarContext ToolbarContext => new(Commands, Localizer, Services);

    private RenderFragment? StatusBarContent => StatusBarSurface;

    private RenderFragment DefaultStatusBar => @<FlareStatusBar>
        <LeftContent>@RenderStatusItems(LatticeStatusBarAlignment.Left)</LeftContent>
        <CenterContent>@RenderStatusItems(LatticeStatusBarAlignment.Center)</CenterContent>
        <RightContent>@RenderStatusItems(LatticeStatusBarAlignment.Right)</RightContent>
    </FlareStatusBar>;

    private RenderFragment RenderStatusItems(LatticeStatusBarAlignment alignment) => @<text>
        @foreach (var item in Catalog.StatusBarItems
                      .Where(candidate => candidate.Alignment == alignment)
                      .OrderBy(candidate => candidate.Order)
                      .ThenBy(candidate => candidate.Id.Value, StringComparer.Ordinal))
        {
            if (item.Component is { } component)
            {
                <DynamicComponent @key="item.Id.Value"
                                  Type="@component"
                                  Parameters="@(new Dictionary<string, object?>
                                  {
                                      [nameof(LatticeStatusBarComponent.Context)] = StatusBarContext
                                  })" />
            }
            else if (item.Command is { } command)
            {
                <FlareButton Variant="ButtonVariant.Text"
                             Size="ButtonSize.Xs"
                             Class="lattice-statusbar__item"
                             AriaLabel="@Localizer.Get(item.Title)"
                             Tooltip="@Localizer.Get(item.Title)"
                             OnClick="() => ExecuteAsync(command)">
                    <LeadingIcon>
                        @if (Icons.Resolve(item.IconKey ?? FindCommand(command)?.IconKey) is { } icon)
                        {
                            <FlareIconView Value="@icon" />
                        }
                    </LeadingIcon>
                    <ChildContent>@Localizer.Get(item.Title)</ChildContent>
                </FlareButton>
            }
            else
            {
                <span class="lattice-statusbar__item">
                    @if (Icons.Resolve(item.IconKey) is { } icon)
                    {
                        <FlareIconView Value="@icon" />
                    }
                    @Localizer.Get(item.Title)
                </span>
            }
        }
    </text>;

    private LatticeStatusBarContext StatusBarContext => new(Commands, Localizer, Services);

    private RenderFragment LeftTools => @<FlareToolPanelGroup Position="ToolPanelPosition.Left"
                                                              TabStripPlacement="TabStripPlacement.Bottom"
                                                              ShowTabStripWhenFloating="false"
                                                              ShowCollapseButton="false">
        <ToolbarContent>
            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs"
                         AriaLabel="@(IsPinned(LatticeToolRegion.Left) ? HostLabel("unpin") : HostLabel("pin"))"
                         OnClick="() => TogglePin(LatticeToolRegion.Left)">
                <FlareIconView Size="1rem" Value="@PinIcon(LatticeToolRegion.Left)" />
            </FlareButton>
            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs"
                         AriaLabel="@HostLabel("close")"
                         OnClick="() => CloseRegion(LatticeToolRegion.Left)">
                <FlareIconView Value="FlareIcons.Close" Size="0.875rem" />
            </FlareButton>
        </ToolbarContent>
        <ChildContent>
            @foreach (var descriptor in VisibleToolWindows(LatticeToolRegion.Left))
            {
                <FlareToolPanel @key="descriptor.Id.Value"
                                Key="@descriptor.Id.Value"
                                Title="@Localizer.Get(descriptor.Title)"
                                Icon="@Icons.Resolve(descriptor.IconKey)"
                                Mode="@PanelMode(LatticeToolRegion.Left)">
                    <DynamicComponent Type="@descriptor.Component"
                                      Parameters="@ToolWindowParameters(descriptor.Id)" />
                </FlareToolPanel>
            }
        </ChildContent>
    </FlareToolPanelGroup>;

    private RenderFragment RightTools => @<FlareToolPanelGroup Position="ToolPanelPosition.Right"
                                                               TabStripPlacement="TabStripPlacement.Bottom"
                                                               ShowTabStripWhenFloating="false"
                                                               ShowCollapseButton="false">
        <ToolbarContent>
            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs"
                         AriaLabel="@(IsPinned(LatticeToolRegion.Right) ? HostLabel("unpin") : HostLabel("pin"))"
                         OnClick="() => TogglePin(LatticeToolRegion.Right)">
                <FlareIconView Size="1rem" Value="@PinIcon(LatticeToolRegion.Right)" />
            </FlareButton>
            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs"
                         AriaLabel="@HostLabel("close")"
                         OnClick="() => CloseRegion(LatticeToolRegion.Right)">
                <FlareIconView Value="FlareIcons.Close" Size="0.875rem" />
            </FlareButton>
        </ToolbarContent>
        <ChildContent>
            @foreach (var descriptor in VisibleToolWindows(LatticeToolRegion.Right))
            {
                <FlareToolPanel @key="descriptor.Id.Value"
                                Key="@descriptor.Id.Value"
                                Title="@Localizer.Get(descriptor.Title)"
                                Icon="@Icons.Resolve(descriptor.IconKey)"
                                Mode="@PanelMode(LatticeToolRegion.Right)">
                    <DynamicComponent Type="@descriptor.Component"
                                      Parameters="@ToolWindowParameters(descriptor.Id)" />
                </FlareToolPanel>
            }
        </ChildContent>
    </FlareToolPanelGroup>;
}
