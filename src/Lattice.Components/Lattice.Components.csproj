<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Lattice</RootNamespace>
    <AssemblyName>Lattice.Components</AssemblyName>
    <Description>Flare IDE host for Lattice - shell layout, documents, tool windows, ribbon and settings surfaces.</Description>
    <!-- The tool-window list is dynamic, so its render-fragment sequence numbers come from the
         loop; ASP0006 is about literal markup only. -->
    <NoWarn>$(NoWarn);ASP0006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lattice.Abstractions\Lattice.Abstractions.csproj" />
    <ProjectReference Include="..\Lattice.Core\Lattice.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalFlare)' != 'true'">
    <PackageReference Include="Flare.Components.IDE" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalFlare)' == 'true'">
    <ProjectReference Include="$(FlareRoot)\src\Flare.Components.IDE\Flare.Components.IDE.csproj" />
  </ItemGroup>
</Project>
