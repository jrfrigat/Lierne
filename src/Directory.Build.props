<Project>
  <Import Project="../Directory.Build.props" />

  <PropertyGroup>
    <IsPackable Condition="'$(UseLocalFlare)' != 'true'">true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>assets/icon.png</PackageIcon>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)docs/nuget-readme.md" Pack="true" PackagePath="README.md" />
    <None Include="$(RepoRoot)LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(RepoRoot)assets/icon.png" Pack="true" PackagePath="assets/" />
    <None Include="$(RepoRoot)docs/articles/**/*.md" Pack="true" PackagePath="docs/articles/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
