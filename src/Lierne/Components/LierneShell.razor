@namespace Lierne
@using Flare.Components
@using Flare.Components.IDE
@using Flare.Icons
@implements IDisposable
@inject LiernePluginCatalog Catalog
@inject ILierneDocumentService Documents
@inject ILierneToolWindowService ToolWindows
@inject ILierneCommandService Commands
@inject ILierneShortcutService Shortcuts
@inject ILierneLocalizer Localizer
@inject ILierneContext State
@inject ILierneIconResolver Icons
@inject IServiceProvider Services

@if (!_workspaceReady)
{
    <div role="status">@HostLabel("stateLoading")</div>
}
else
{
    <FlareIdeLayout id="@(_persistence is null ? null : _layoutId)"
                    Documents="@IdeDocuments"
                    ActiveDocuments="@ActiveDocuments"
                    Height="100%"
                    LeftPanelWidth="@PanelSize(LierneToolRegion.Left)"
                    RightPanelWidth="@PanelSize(LierneToolRegion.Right)"
                    BottomPanelHeight="@PanelSize(LierneToolRegion.Bottom)"
                    LeftCollapsed="@_panels[LierneToolRegion.Left].Collapsed"
                    LeftCollapsedChanged="collapsed => SetCollapsed(LierneToolRegion.Left, collapsed)"
                    RightCollapsed="@_panels[LierneToolRegion.Right].Collapsed"
                    RightCollapsedChanged="collapsed => SetCollapsed(LierneToolRegion.Right, collapsed)"
                    BottomCollapsed="@_panels[LierneToolRegion.Bottom].Collapsed"
                    BottomCollapsedChanged="collapsed => SetCollapsed(LierneToolRegion.Bottom, collapsed)"
                    LeftActiveToolKey="@_panels[LierneToolRegion.Left].ToolKey"
                    LeftActiveToolKeyChanged="key => SetSelectedTool(LierneToolRegion.Left, key)"
                    RightActiveToolKey="@_panels[LierneToolRegion.Right].ToolKey"
                    RightActiveToolKeyChanged="key => SetSelectedTool(LierneToolRegion.Right, key)"
                    DocumentMounting="IdeDocumentMounting.ActiveOnly"
                    LeftRegionVisible="@HasLeftRegion"
                    RightRegionVisible="@HasRightRegion"
                    LeftToolPanel="@RenderTools(LierneToolRegion.Left, ToolPanelPosition.Left)"
                    RightToolPanel="@RenderTools(LierneToolRegion.Right, ToolPanelPosition.Right)"
                    Ribbon="@RibbonContent"
                    MenuBar="@MenuBarContent"
                    ChildContent="@StartSurfaceContent"
                    BottomPanel="@BottomPanelSurface"
                    BottomHeaderContent="@BottomHeaderSurface"
                    ShowBottomHeader="@(ShellContent(LierneShellSlot.BottomHeader) is not null)"
                    ShowBottomPin="true"
                    ShowBottomCollapse="false"
                    BottomPinned="@IsPinned(LierneToolRegion.Bottom)"
                    BottomPinnedChanged="OnBottomPinnedChanged"
                    StatusBar="@StatusBarContent"
                    DocumentHeaderContent="@DockDocumentHeaderContent"
                    OnActiveDocumentChanged="OnActiveDocumentChanged"
                    OnDocumentCloseRequested="OnDocumentCloseRequested"
                    OnDocumentMove="OnDocumentMove">
        <CenterDockHeader>
            <div class="q-main-tabs">
                <FlareDocumentTabs StripOnly="true"
                                   Dockable="true"
                                   ControlledSelection="true"
                                   ActiveKey="@ActiveCenterKey"
                                   ActiveKeyChanged="OnTabActivated"
                                   OnCloseRequested="OnTabCloseRequested">
                    <ContextMenuContent Context="key">
                        <FlareMenuItem OnClick="() => CloseTab(key)">@Localizer.Get(LierneHostPlugin.Key("close"))</FlareMenuItem>
                        <FlareMenuItem OnClick="CloseAllTabs">@Localizer.Get(LierneHostPlugin.Key("closeAll"))</FlareMenuItem>
                        <FlareMenuItem OnClick="() => CloseOtherTabs(key)">@Localizer.Get(LierneHostPlugin.Key("closeOthers"))</FlareMenuItem>
                        <FlareMenuSeparator />
                        @foreach (var target in TabDockTargets)
                        {
                            <FlareMenuItem @key="target.Location" OnClick="() => MoveDocument(key, target.Location)">@target.Label</FlareMenuItem>
                        }
                    </ContextMenuContent>
                    <ChildContent>
                        @foreach (var document in MainDocuments)
                        {
                            var title = Localizer.Get(document.Title);
                            <FlareDocumentTab @key="document.Id"
                                              Key="@document.Id"
                                              Title="@title"
                                              Icon="@DocumentIcon(document)"
                                              HeaderContent="@MainDocumentHeader(document, title)"
                                              Closeable="true" />
                        }
                    </ChildContent>
                </FlareDocumentTabs>
            </div>
        </CenterDockHeader>

        <DocumentContent Context="document">@RenderDocument(document)</DocumentContent>
    </FlareIdeLayout>
}

@code {
    private IReadOnlyList<ToolbarDescriptor>? _toolbars;
    private ILookup<LierneStatusBarAlignment, StatusBarItemDescriptor>? _statusItems;

    private RenderFragment RenderLegacyDocumentHeader(FlareIcon icon, string title) => @<text>
        <FlareIconView Value="@icon" Size="0.875rem" />
        @title
    </text>;

    private IReadOnlyList<ToolbarDescriptor> Toolbars =>
        _toolbars ??= Catalog.Toolbars
            .OrderBy(toolbar => toolbar.Order)
            .ThenBy(toolbar => toolbar.Id.Value, StringComparer.Ordinal)
            .ToArray();

    private RenderFragment? RibbonContent =>
        Toolbars.Count > 0 ? null : @<FlareRibbon>
            <FlareRibbonTab Title="@RibbonTitle">
                @foreach (var group in RibbonGroups)
                {
                    <FlareRibbonGroup @key="group.Id.Value" Label="@Localizer.Get(group.Title)">
                        @foreach (var item in ItemsFor(group.Id))
                        {
                            var command = FindCommand(item.Command);
                            <FlareRibbonButton @key="item.Id.Value"
                                               Icon="@Icons.Resolve(item.IconKey ?? command?.IconKey)"
                                               Label="@CommandLabel(item.Command)"
                                               Tooltip="@CommandLabel(item.Command)"
                                               Disabled="@(!Commands.CanExecute(item.Command))"
                                               OnClick="() => ExecuteAsync(item.Command)" />
                        }
                    </FlareRibbonGroup>
                }
            </FlareRibbonTab>
        </FlareRibbon>;

    private RenderFragment MenuBarContent => @<text>
        @if (ShellContent(LierneShellSlot.MenuBar) is { } shellMenuBar)
        {
            <DynamicComponent @key="shellMenuBar.Id.Value" Type="@shellMenuBar.Component" />
        }
        else if (MenuBar is not null)
        {
            @MenuBar
        }
        else
        {
            <FlareMenuBar>
                @foreach (var group in MenuGroups)
                {
                    <FlareMenu @key="group.Id.Value"
                               Anchor="MenuAnchor.BottomLeft"
                               AriaLabel="@Localizer.Get(group.Title)">
                        <Activator>
                            <FlareButton Variant="ButtonVariant.Text"
                                         Size="ButtonSize.Sm"
                                         @attributes="context.Attributes">@Localizer.Get(group.Title)</FlareButton>
                        </Activator>
                        <ChildContent>
                            @foreach (var item in ItemsFor(group.Id))
                            {
                                <LierneMenuEntry Item="item" ExecuteCommand="ExecuteAsync" />
                            }
                        </ChildContent>
                    </FlareMenu>
                }
            </FlareMenuBar>
        }
        @foreach (var toolbar in Toolbars)
        {
            <DynamicComponent @key="toolbar.Id.Value"
                              Type="@toolbar.Component"
                              Parameters="@(new Dictionary<string, object?>
                              {
                                  [nameof(LierneToolbarComponent.Context)] = ToolbarContext
                              })" />
        }
        @if (_commandFailure is { } failure)
        {
            <FlareAlert @key="failure" Severity="AlertSeverity.Error"
                        Dismissible="true" OnDismiss="DismissCommandFailure">
                @Localizer.GetError(failure.ErrorCode ?? "lattice.command.failed", failure.ErrorMessage)
            </FlareAlert>
        }
        @if (_stateWarning is { } warning)
        {
            <FlareAlert Severity="AlertSeverity.Warning"
                        Dismissible="true" OnDismiss="@(() => _stateWarning = null)">
                @HostLabel(warning)
            </FlareAlert>
        }
    </text>;

    private LierneToolbarContext ToolbarContext => new(Commands, Localizer, Services);

    private RenderFragment? StatusBarContent => StatusBarSurface;

    private RenderFragment DefaultStatusBar => @<FlareStatusBar>
        <LeftContent>@RenderStatusItems(LierneStatusBarAlignment.Left)</LeftContent>
        <CenterContent>@RenderStatusItems(LierneStatusBarAlignment.Center)</CenterContent>
        <RightContent>@RenderStatusItems(LierneStatusBarAlignment.Right)</RightContent>
    </FlareStatusBar>;

    private RenderFragment RenderStatusItems(LierneStatusBarAlignment alignment) => @<text>
        @foreach (var item in StatusItems(alignment))
        {
            if (item.Component is { } component)
            {
                <DynamicComponent @key="item.Id.Value"
                                  Type="@component"
                                  Parameters="@(new Dictionary<string, object?>
                                  {
                                      [nameof(LierneStatusBarComponent.Context)] = StatusBarContext
                                  })" />
            }
            else if (item.Command is { } command)
            {
                <FlareButton Variant="ButtonVariant.Text"
                             Size="ButtonSize.Xs"
                             Class="lierne-statusbar__item"
                             AriaLabel="@Localizer.Get(item.Title)"
                             Tooltip="@Localizer.Get(item.Title)"
                             Disabled="@(!Commands.CanExecute(command))"
                             OnClick="() => ExecuteAsync(command)">
                    <LeadingIcon>
                        @if (Icons.Resolve(item.IconKey ?? FindCommand(command)?.IconKey) is { } icon)
                        {
                            <FlareIconView Value="@icon" />
                        }
                    </LeadingIcon>
                    <ChildContent>@Localizer.Get(item.Title)</ChildContent>
                </FlareButton>
            }
            else
            {
                <span class="lierne-statusbar__item">
                    @if (Icons.Resolve(item.IconKey) is { } icon)
                    {
                        <FlareIconView Value="@icon" />
                    }
                    @Localizer.Get(item.Title)
                </span>
            }
        }
    </text>;

    private IEnumerable<StatusBarItemDescriptor> StatusItems(LierneStatusBarAlignment alignment) =>
        (_statusItems ??= Catalog.StatusBarItems
            .OrderBy(item => item.Order)
            .ThenBy(item => item.Id.Value, StringComparer.Ordinal)
            .ToLookup(item => item.Alignment))[alignment];

    private LierneStatusBarContext StatusBarContext => new(Commands, Localizer, Services);

    private RenderFragment? BottomPanelSurface
    {
        get
        {
            var content = CustomBottomPanel;
            var hasTools = HasVisibleTool(LierneToolRegion.Bottom);
            return content is null && !hasTools ? null : RenderBottomSurfaces(content, hasTools);
        }
    }

    private RenderFragment RenderBottomSurfaces(RenderFragment? content, bool hasTools) =>
        @<div class="@(content is not null && hasTools ? "lierne-bottom-surfaces lierne-bottom-surfaces--split" : "lierne-bottom-surfaces")">
        @if (content is not null)
        {
            <div>@content</div>
        }
        @if (hasTools)
        {
            <div>@RenderTools(LierneToolRegion.Bottom, ToolPanelPosition.Bottom)</div>
        }
    </div>;

    private RenderFragment RenderTools(LierneToolRegion region, ToolPanelPosition position) =>
        @<FlareToolPanelGroup Position="@position"
                                                               ActiveKey="@_panels[region].ToolKey"
                                                               ActiveKeyChanged="key => SetSelectedTool(region, key)"
                                                               TabStripPlacement="TabStripPlacement.Bottom"
                                                               ShowTabStripWhenFloating="false"
                                                               ShowCollapseButton="false">
        <ToolbarContent>
            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs"
                         AriaLabel="@(IsPinned(region) ? HostLabel("unpin") : HostLabel("pin"))"
                         OnClick="() => TogglePin(region)">
                <FlareIconView Size="1rem" Value="@PinIcon(region)" />
            </FlareButton>
            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Xs"
                         AriaLabel="@HostLabel("close")"
                         OnClick="() => CloseRegion(region)">
                <FlareIconView Value="FlareIcons.Close" Size="0.875rem" />
            </FlareButton>
        </ToolbarContent>
        <ChildContent>
            @foreach (var descriptor in ToolDescriptors(region))
            {
                @if (ToolWindows.IsVisible(descriptor.Id))
                {
                    <FlareToolPanel @key="descriptor.Id.Value"
                                    Key="@descriptor.Id.Value"
                                    Title="@Localizer.Get(descriptor.Title)"
                                    Icon="@Icons.Resolve(descriptor.IconKey)"
                                    Mode="@PanelMode(region)">
                        <DynamicComponent Type="@descriptor.Component"
                                          Parameters="@ToolWindowParameters(descriptor.Id)" />
                    </FlareToolPanel>
                }
            }
        </ChildContent>
    </FlareToolPanelGroup>;
}
