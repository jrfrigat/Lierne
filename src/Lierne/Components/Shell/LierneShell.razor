@namespace Lierne
@using Flare.Components

<FlareStack Height="100%" MinHeight="0" Gap="FlareSpacing.None">
    @if (Options.ShowNotifications)
    {
        @if (NotificationsContent is not null)
        {
            @NotificationsContent
        }
        else
        {
            <LierneNotificationHost />
        }
    }

    @if (Options.ShowCommandBar)
    {
        @if (CommandBarContent is not null)
        {
            @CommandBarContent
        }
        else
        {
            <LierneCommandBar RibbonTitle="@RibbonTitle"
                              MenuBar="@MenuBar"
                              ShowMenuBar="@Options.ShowMenuBar"
                              ShowRibbon="@Options.ShowRibbon"
                              ShowToolbars="@Options.ShowToolbars"
                              ShowPaletteButton="@Options.ShowPaletteButton" />
        }
    }

    @if (Options.ShowWorkspace)
    {
        <FlareStack Row="true" StretchLast="true" Align="FlareAlignItems.Stretch" FlexGrow="1"
                    MinHeight="0" MinWidth="0">
            @if (WorkspaceContent is not null)
            {
                <FlareStack MinHeight="0" MinWidth="0">@WorkspaceContent</FlareStack>
            }
            else
            {
                <LierneWorkspace StartContent="@StartContent"
                                 BottomPanel="@BottomPanel"
                                 DocumentHeaderContent="@DocumentHeaderContent"
                                 ShowStartPage="@Options.ShowStartPage"
                                 ShowBottomPanel="@Options.ShowBottomPanel"
                                 DropZones="@DropZones"
                                 ShowDropGuide="@ShowDropGuide" />
            }
        </FlareStack>
    }

    @if (Options.ShowStatusBar)
    {
        <LierneStatusBar Content="@StatusBar" />
    }

    @if (Options.ShowCommandPalette)
    {
        @if (CommandPaletteContent is not null)
        {
            @CommandPaletteContent
        }
        else
        {
            <LierneCommandPalette />
        }
    }
</FlareStack>
