@namespace Lierne
@using Flare.Components
@using Flare.Icons

<FlareOverlay Open="_open" OnBackdropClick="BackdropClick">
    <FlareStack Height="100%" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.Start"
                Padding="FlareSpacing.Small" PaddingBlockStart="FlareSpacing.XLarge"
                role="dialog" aria-modal="true" aria-label="@Title"
                @onkeydown="HandleKeyDownAsync">
        <FlareStack Width="100%" MaxWidth="42rem" MinWidth="0">
            <FlarePaper Elevation="4" Padding="FlareSpacing.Small">
                <FlareStack Gap="FlareSpacing.Small" MinHeight="0">
                    <FlareTextField Value="@_query"
                                    ValueChanged="OnQueryChanged"
                                    Placeholder="@Placeholder"
                                    Size="FieldSize.Sm"
                                    InputAttributes="InputAttributes" />
                    <FlareStack MaxHeight="70vh" Overflow="auto" MinHeight="0">
                        <FlareList TItem="object" Dense="true" aria-label="@Title">
                            @if (_results.Count == 0)
                            {
                                <FlareListItem Primary="@EmptyText" Disabled="true" />
                            }
                            else
                            {
                                @for (var index = 0; index < _results.Count; index++)
                                {
                                    var descriptor = _results[index];
                                    var presentation = Presentation(descriptor);
                                    var selected = index == _selected;
                                    <FlareListItem @key="descriptor.Id.Value"
                                                   Primary="@Localizer.Get(TitleOf(descriptor, presentation))"
                                                   Secondary="@DescriptionOf(presentation)"
                                                   Selected="@selected"
                                                   Disabled="@(!presentation.Enabled)"
                                                   OnClick="() => ExecuteAsync(descriptor)">
                                        <Leading>
                                            @if (IconOf(descriptor, presentation) is { } icon)
                                            {
                                                <FlareIconView Value="icon" Size="1rem" />
                                            }
                                        </Leading>
                                        <Trailing>
                                            @if (presentation.ShortcutText is { Length: > 0 } shortcut)
                                            {
                                                <FlareText Typo="TypographyScale.LabelSmall"
                                                           Color="FlareColor.OnSurfaceVariant">@shortcut</FlareText>
                                            }
                                        </Trailing>
                                    </FlareListItem>
                                }
                            }
                        </FlareList>
                    </FlareStack>
                </FlareStack>
            </FlarePaper>
        </FlareStack>
    </FlareStack>
</FlareOverlay>
