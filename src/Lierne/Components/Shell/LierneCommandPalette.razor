@namespace Lierne
@using Flare.Components
@using Flare.Icons

@if (_open)
{
    <div class="lierne-palette" @onclick="BackdropClick">
        <div class="lierne-palette__dialog" role="dialog" aria-modal="true" aria-label="@Title"
             @onclick:stopPropagation="true" @onkeydown="HandleKeyDownAsync">
            <FlareTextField Value="@_query"
                            ValueChanged="OnQueryChanged"
                            Placeholder="@Placeholder"
                            Size="FieldSize.Sm"
                            InputAttributes="InputAttributes" />
            <div class="lierne-palette__list" role="listbox" aria-label="@Title">
                @if (_results.Count == 0)
                {
                    <p class="lierne-palette__empty">@EmptyText</p>
                }
                else
                {
                    @for (var index = 0; index < _results.Count; index++)
                    {
                        var descriptor = _results[index];
                        var presentation = Presentation(descriptor);
                        var selected = index == _selected;
                        <button @key="descriptor.Id.Value"
                                type="button"
                                role="option"
                                aria-selected="@(selected ? "true" : "false")"
                                class="@(selected ? "lierne-palette__item lierne-palette__item--selected" : "lierne-palette__item")"
                                disabled="@(!presentation.Enabled)"
                                @onclick="() => ExecuteAsync(descriptor)">
                            @if (IconOf(descriptor, presentation) is { } icon)
                            {
                                <FlareIconView Value="icon" Size="1rem" />
                            }
                            <span class="lierne-palette__title">@Localizer.Get(TitleOf(descriptor, presentation))</span>
                            @if (presentation.ShortcutText is { Length: > 0 } shortcut)
                            {
                                <span class="lierne-palette__shortcut">@shortcut</span>
                            }
                            @if (DescriptionOf(presentation) is { Length: > 0 } description)
                            {
                                <span class="lierne-palette__description">@description</span>
                            }
                        </button>
                    }
                }
            </div>
        </div>
    </div>
}
