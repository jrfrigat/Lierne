@namespace Lierne
@using Flare.Components
@using Flare.Components.IDE
@using Flare.Icons

@if (!_workspaceReady)
{
    <FlareStack Align="FlareAlignItems.Center" Justify="FlareJustifyContent.Center" Height="100%" FlexGrow="1">
        <FlareText>@HostLabel("stateLoading")</FlareText>
    </FlareStack>
}
else
{
    <FlareStack id="@_workspaceId" Height="100%" FlexGrow="1" MinHeight="0">
        <FlareStack StretchItems="true" FlexGrow="1" MinWidth="0" MinHeight="0">
            <FlareDockWorkspace Layout="_layout"
                                Items="_items"
                                OnChangeRequested="ApplyChangeAsync"
                                CanRequest="CanRequest"
                                DropZones="@DropZones"
                                ShowDropGuide="@ShowDropGuide"
                                @attributes="_dockTabParameters"
                                ContentTemplate="_dockContentTemplate"
                                GroupLabel="GroupLabel">
                <TabTemplate Context="item">
                    @{
                        var entry = Entry(item.Key);
                        var document = DocumentHeaderContent is not null ? TabDocument(item.Key) : entry?.Document;
                    }
                    @if (item.Icon is { } icon)
                    {
                        <FlareIconView Value="icon" Size="0.875rem" />
                    }
                    @if (document is not null && DocumentHeaderContent is { } template)
                    {
                        @template(new LierneDocumentHeaderContext(document, item.Title))
                    }
                    else
                    {
                        @if (document?.StatusIconKey is { } statusKey &&
                             ResolveIcon(statusKey, document.StatusIconColor) is { } statusIcon)
                        {
                            <FlareIconView Value="statusIcon" Size="0.75rem" data-lierne-marker="status" />
                        }
                        <FlareText Element="span">@item.Title</FlareText>
                    }
                    @if (item.BadgeDot)
                    {
                        <FlareIconView Value="PreviewDot" Size="0.375rem" data-lierne-marker="preview" />
                    }
                </TabTemplate>
                <TabMarkerTemplate Context="item">
                    @{
                        var entry = Entry(item.Key);
                        var document = entry?.Document;
                    }
                    @if (document?.Pinned == true)
                    {
                        <FlareIconView Value="FlareIcons.PushPin" Size="0.75rem" data-lierne-marker="pin" />
                    }
                </TabMarkerTemplate>
                <TabActionsTemplate Context="item">
                    @if (item.CanClose)
                    {
                        var closeLabel = $"{HostLabel("close")} {item.Title}";
                        <FlareIconButton Size="FlareSize.Xs"
                                         Variant="ButtonVariant.Text"
                                         Icon="FlareIcons.Close"
                                         AriaLabel="@closeLabel"
                                         Tooltip="@closeLabel"
                                         OnClick="() => CloseItem(item)" />
                    }
                </TabActionsTemplate>
            </FlareDockWorkspace>
        </FlareStack>
    </FlareStack>
}
