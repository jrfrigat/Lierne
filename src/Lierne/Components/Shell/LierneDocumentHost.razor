@namespace Lierne
@using Flare.Components
@inject ILierneDocumentService Documents
@inject ILierneCommandService Commands
@inject ILierneLocalizer Localizer
@inject LiernePluginCatalog Catalog
@inject IServiceProvider Services
@inject ILierneIconResolver Icons

@if (Instance is { } document)
{
    var views = Catalog.ViewsFor(document.TypeId);
    var descriptor = Descriptor(document.TypeId);
    if (views.Count > 0)
    {
        if (descriptor?.ViewLayout is not null &&
            LayoutFor(document.TypeId) is { Groups.Count: > 0 } layout)
        {
            <LierneDocumentViewLayoutHost Document="document" Layout="layout" Node="layout.Root" />
        }
        else
        {
            <FlareStack Height="100%" MinHeight="0" MinWidth="0" StretchItems="true">
                <FlareTabs FillHeight="true" ActiveIndex="@SelectedIndex(document, views)" ActiveIndexChanged="SelectView" Lazy="true">
                    @foreach (var view in views)
                    {
                        var title = Localizer.Get(view.Title);
                        <FlareTab @key="view.Id.Value"
                                  Key="@view.Id.Value"
                                  Label="@title"
                                  Tooltip="@title">
                            <LeadingIcon>
                                @if (Icons.Resolve(view.IconKey) is { } icon)
                                {
                                    <FlareIconView Value="icon" Size="1rem" />
                                }
                            </LeadingIcon>
                            <ChildContent>
                                <DynamicComponent Type="@view.Component"
                                                  Parameters="@ViewParameters(document, view)" />
                            </ChildContent>
                        </FlareTab>
                    }
                </FlareTabs>
            </FlareStack>
        }
    }
    else if (descriptor is { } plain)
    {
        <FlareStack Height="100%" MinHeight="0" MinWidth="0" StretchItems="true">
            <DynamicComponent Type="@plain.Component"
                              Parameters="@DocumentParameters(document)" />
        </FlareStack>
    }
}

@code {
    /// <summary>Gets or sets the document instance shown by the host.</summary>
    [Parameter]
    public string DocumentId { get; set; } = string.Empty;

    /// <summary>Gets or sets the document snapshot to display in place of looking it up by id.</summary>
    [Parameter]
    public LierneDocumentInstance? Document { get; set; }

    private readonly Dictionary<DocumentTypeId, LierneDocumentViewLayout> _layouts = [];
    private LierneDocumentInstance? _renderedDocument;
    private Dictionary<string, object?>? _documentParameters;
    private readonly Dictionary<DocumentViewId, Dictionary<string, object?>> _viewParameters = [];

    private LierneDocumentInstance? Instance
    {
        get
        {
            if (Document is not null)
            {
                return Document;
            }

            if (Documents is LierneDocumentService service)
            {
                return service.Find(DocumentId);
            }

            var documents = Documents.Documents;
            for (var index = 0; index < documents.Count; index++)
            {
                if (documents[index].Id == DocumentId)
                {
                    return documents[index];
                }
            }

            return null;
        }
    }

    private static int SelectedIndex(LierneDocumentInstance document, IReadOnlyList<DocumentViewDescriptor> views)
    {
        for (var index = 0; index < views.Count; index++)
        {
            if (views[index].Id == document.SelectedView)
            {
                return index;
            }
        }

        return 0;
    }

    private DocumentDescriptor? Descriptor(DocumentTypeId type) =>
        Catalog.Documents.FirstOrDefault(descriptor => descriptor.Id == type);

    private LierneDocumentViewLayout LayoutFor(DocumentTypeId type)
    {
        if (_layouts.TryGetValue(type, out var layout))
        {
            return layout;
        }

        layout = LierneDocumentViewLayoutResolver.Resolve(
            Descriptor(type)?.ViewLayout,
            Catalog.ViewsFor(type));
        _layouts.Add(type, layout);
        return layout;
    }

    private void SelectView(int index)
    {
        if (Instance is not { } document)
        {
            return;
        }

        var views = Catalog.ViewsFor(document.TypeId);
        if ((uint)index < (uint)views.Count)
        {
            Documents.SetSelectedView(document.Id, views[index].Id);
        }
    }

    private void SetParameterDocument(LierneDocumentInstance document)
    {
        if (!ReferenceEquals(_renderedDocument, document))
        {
            _renderedDocument = document;
            _documentParameters = null;
            _viewParameters.Clear();
        }
    }

    private Dictionary<string, object?> DocumentParameters(LierneDocumentInstance document)
    {
        SetParameterDocument(document);
        return _documentParameters ??= new()
        {
            [nameof(LierneDocumentComponent.Context)] =
                new LierneDocumentContext(document, Commands, Documents, Localizer, Services)
        };
    }

    private Dictionary<string, object?> ViewParameters(
        LierneDocumentInstance document,
        DocumentViewDescriptor view)
    {
        SetParameterDocument(document);
        if (!_viewParameters.TryGetValue(view.Id, out var parameters))
        {
            parameters = new Dictionary<string, object?>
            {
                [nameof(LierneDocumentViewComponent.Context)] =
                    new LierneDocumentViewContext(document, view, Commands, Documents, Localizer, Services)
            };
            _viewParameters.Add(view.Id, parameters);
        }

        return parameters;
    }
}
