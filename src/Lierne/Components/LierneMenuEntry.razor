@namespace Lierne
@using Flare.Components
@inject ILierneCommandService Commands
@inject ILierneShortcutService Shortcuts
@inject ILierneLocalizer Localizer

@if (Item.IsSeparator)
{
    <FlareMenuSeparator />
}
else if (Item.Children is { Count: > 0 } children)
{
    <FlareSubMenu Label="@Localizer.Get(Item.Title)" Disabled="@Disabled">
        @foreach (var child in children)
        {
            <LierneMenuEntry Item="child" ExecuteCommand="ExecuteCommand" />
        }
    </FlareSubMenu>
}
else
{
    <FlareMenuItem Shortcut="@ShortcutText"
                   Disabled="@Disabled"
                   OnClick="() => InvokeAsync()">@Localizer.Get(Item.Title)</FlareMenuItem>
}

@code {
    /// <summary>Gets or sets the menu item to render.</summary>
    [Parameter, EditorRequired]
    public MenuItemDescriptor Item { get; set; } = null!;

    /// <summary>Handles command execution and any failure feedback in the enclosing shell.</summary>
    [Parameter]
    public EventCallback<CommandId> ExecuteCommand { get; set; }

    private bool Disabled => Item.Command is { } command && !Commands.CanExecute(command);

    private string? ShortcutText => Item.Command is { } command
        ? Shortcuts.Bindings
            .FirstOrDefault(binding => binding.Command == command)
            ?.EffectiveShortcut
        : null;

    private Task InvokeAsync()
    {
        if (Item.Command is not { } command)
        {
            return Task.CompletedTask;
        }

        return ExecuteCommand.HasDelegate ? ExecuteCommand.InvokeAsync(command) : Commands.ExecuteAsync(command);
    }
}
