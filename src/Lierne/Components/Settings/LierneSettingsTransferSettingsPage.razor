@namespace Lierne
@using System.Text
@using System.Text.Json
@using Flare.Abstractions
@using Flare.Abstractions.Tokens
@using Flare.Components
@using Flare.Icons
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject LierneSettingsTransfer Transfer
@inject LiernePluginCatalog Catalog
@inject ILierneLocalizer Localizer
@inject IServiceProvider Services
@inject IJSRuntime JS

<FlareStack Gap="FlareSpacing.Small">
    <FlareText Color="FlareColor.OnSurfaceVariant">@Localizer.Get(Key("transferHint"))</FlareText>

    <div style="display:flex;flex-wrap:wrap;gap:var(--flare-spacing-2);align-items:center;">
        <FlareButton Variant="ButtonVariant.Outlined"
                     Size="ButtonSize.Sm"
                     Loading="@_busy"
                     OnClick="ExportAsync">
            <LeadingIcon>
                <FlareIconView Value="FlareIcons.Download" Size="1rem" />
            </LeadingIcon>
            <ChildContent>@Localizer.Get(Key("exportSettings"))</ChildContent>
        </FlareButton>

        <FlareFileUploadButton Variant="ButtonVariant.Outlined"
                               Size="ButtonSize.Sm"
                               Accept=".json,application/json"
                               MaxFiles="1"
                               MaxFileSize="@MaxFileBytes"
                               Loading="@_busy"
                               Text="@Localizer.Get(Key("importSettings"))"
                               AriaLabel="@Localizer.Get(Key("importSettings"))"
                               OnFilesChanged="ImportAsync">
            <LeadingIcon>
                <FlareIconView Value="FlareIcons.Upload" Size="1rem" />
            </LeadingIcon>
        </FlareFileUploadButton>
    </div>

    <FlarePaper Outlined="true" Padding="FlareSpacing.Small"
                Style="margin-block-start:var(--flare-spacing-2);">
        <FlareText Weight="FontWeight.SemiBold"
                   Style="margin-block-end:var(--flare-spacing-1);">@Localizer.Get(Key("transferSections"))</FlareText>
        @if (Catalog.SettingsTransfers.Count == 0)
        {
            <FlareText Color="FlareColor.OnSurfaceVariant">@Localizer.Get(Key("transferEmpty"))</FlareText>
        }
        else
        {
            <ul style="margin:0;padding-inline-start:var(--flare-spacing-5);">
                @foreach (var section in Catalog.SettingsTransfers)
                {
                    <li>@Localizer.Get(section.Title)</li>
                }
            </ul>
        }
    </FlarePaper>

    @if (_message is { Length: > 0 })
    {
        <FlareText Color="@(_isError ? FlareColor.Error : FlareColor.Success)"
                   role="status">@_message</FlareText>
    }
</FlareStack>

@code {
    private const long MaxFileBytes = 4 * 1024 * 1024;

    private IJSObjectReference? _module;
    private bool _busy;
    private bool _isError;
    private string? _message;

    private static StringKey Key(string name) => LierneHostPlugin.Key(name);

    private async Task ExportAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            var result = Transfer.Export(Services);
            if (!result.Success || result.Data is not { } json)
            {
                ShowError(result.ErrorCode, result.ErrorMessage);
                return;
            }

            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Lierne/lierne.js");
            await _module.InvokeVoidAsync(
                "downloadText",
                "lierne-settings.json",
                json,
                "application/json");
            _isError = false;
            _message = Localizer.Get(Key("transferExported"));
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException)
        {
            ShowError("lattice.settings.export_failed", exception.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ImportAsync(IReadOnlyList<IBrowserFile> files)
    {
        if (files.Count == 0)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            await using var stream = files[0].OpenReadStream(MaxFileBytes);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var result = Transfer.Import(json, Services);
            if (!result.Success)
            {
                ShowError(result.ErrorCode, result.ErrorMessage);
                return;
            }

            _isError = false;
            _message = Localizer.Get(Key("transferImported"));
        }
        catch (IOException exception)
        {
            ShowError("lattice.settings.file_too_large", exception.Message);
        }
        catch (Exception exception) when (exception is JsonException or InvalidOperationException)
        {
            ShowError("lattice.settings.invalid_json", exception.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ShowError(string? code, string? fallback)
    {
        _isError = true;
        _message = Localizer.GetError(code ?? "lattice.settings.import_failed", fallback);
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser is gone; there is nothing left to dispose.
        }
    }
}
