@namespace Lierne
@using Flare.Abstractions
@using Flare.Components
@using Flare.Components.IDE
@implements IDisposable
@inject LiernePluginCatalog Catalog
@inject ILierneShortcutService Shortcuts
@inject ILierneLocalizer Localizer

<FlareStack Gap="FlareSpacing.Small">
    @foreach (var group in Groups)
    {
        <FlareStack Gap="FlareSpacing.XSmall" @key="group.Plugin">
            <FlareText Typo="TypographyScale.LabelMedium"
                       Transform="TextTransform.Uppercase"
                       Color="FlareColor.OnSurfaceVariant">@Localizer.Get(group.Title)</FlareText>
            @foreach (var binding in group.Bindings)
            {
                <div style="display:flex;align-items:center;gap:var(--flare-spacing-2);min-block-size:2rem;"
                     @key="binding.Command.Value">
                    <FlareText Style="flex:0 0 220px;min-inline-size:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@Localizer.Get(binding.Title)</FlareText>
                    <div style="flex:1 1 auto;min-inline-size:0;max-inline-size:22.5rem;">
                        <FlareShortcutEditor Compact="true"
                                             AriaLabel="@Localizer.Get(binding.Title)"
                                             Value="@binding.EffectiveShortcut"
                                             DefaultValue="@binding.DefaultShortcut"
                                             AssignedShortcuts="@AssignedFor(binding)"
                                             ValueChanged="value => SetAsync(binding, value)" />
                    </div>
                </div>
            }
        </FlareStack>
    }
    @if (_error is { Length: > 0 })
    {
        <FlareText Typo="TypographyScale.BodySmall"
                   Color="FlareColor.Error">@_error</FlareText>
    }
    @if (_conflict is { Length: > 0 })
    {
        <FlareText Typo="TypographyScale.BodySmall"
                   Color="FlareColor.Error">@_conflict</FlareText>
    }
</FlareStack>

@code {
    private string? _error;
    private string? _conflict;

    private IReadOnlyList<CommandGroup> Groups => BuildGroups();

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Shortcuts.Changed += OnShortcutsChanged;
        UpdateConflicts();
    }

    /// <inheritdoc />
    public void Dispose() => Shortcuts.Changed -= OnShortcutsChanged;

    private IReadOnlyList<CommandGroup> BuildGroups()
    {
        var ownerByCommand = Catalog.CommandRegistrations
            .Where(registration => registration.Plugin is not null && registration.Descriptor.ArgumentType is null)
            .ToDictionary(
                registration => registration.Descriptor.Id,
                registration => registration.Plugin!.Value);
        var groups = new List<CommandGroup>();
        foreach (var plugin in Catalog.Plugins.OrderBy(plugin => plugin.Order))
        {
            var bindings = Shortcuts.Bindings
                .Where(binding =>
                    ownerByCommand.TryGetValue(binding.Command, out var owner) &&
                    owner == plugin.Id)
                .OrderBy(binding => Localizer.Get(binding.Title), StringComparer.CurrentCulture)
                .ToArray();
            if (bindings.Length > 0)
            {
                groups.Add(new CommandGroup(plugin.Id, plugin.DisplayName, bindings));
            }
        }

        return groups;
    }

    private IEnumerable<string> AssignedFor(LierneShortcutBinding binding) =>
        Shortcuts.Bindings
            .Where(candidate =>
                candidate.Command != binding.Command &&
                !string.IsNullOrWhiteSpace(candidate.EffectiveShortcut))
            .Select(candidate => candidate.EffectiveShortcut!);

    private Task SetAsync(LierneShortcutBinding binding, string? value)
    {
        var result = Shortcuts.ApplyOverrides(new Dictionary<string, string>(StringComparer.Ordinal)
        {
            [binding.Command.Value] = value ?? string.Empty
        });
        _error = result.Success
            ? null
            : result.ErrorCode is { } code
                ? Localizer.GetError(code, result.ErrorMessage)
                : result.ErrorMessage;
        UpdateConflicts();
        return Task.CompletedTask;
    }

    private void OnShortcutsChanged() => _ = InvokeAsync(() =>
    {
        UpdateConflicts();
        StateHasChanged();
    });

    private void UpdateConflicts()
    {
        var gestures = Shortcuts.FindConflicts()
            .Select(conflict => conflict.Gesture)
            .ToArray();
        _conflict = gestures.Length == 0
            ? null
            : string.Format(
                System.Globalization.CultureInfo.CurrentCulture,
                Localizer.Get(LierneHostPlugin.Key("shortcutConflict")),
                string.Join(", ", gestures));
    }

    private sealed record CommandGroup(
        PluginId Plugin,
        StringKey Title,
        IReadOnlyList<LierneShortcutBinding> Bindings);
}
