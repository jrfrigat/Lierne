<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Lierne</RootNamespace>
    <AssemblyName>Lierne</AssemblyName>
    <Description>Flare IDE host for Lierne - shell layout, documents, tool windows, ribbon and settings surfaces.</Description>
    <PackageTags>blazor;ide;workspace;plugins;flare</PackageTags>
    <!-- The tool-window list is dynamic, so its render-fragment sequence numbers come from the
         loop; ASP0006 is about literal markup only. -->
    <NoWarn>$(NoWarn);ASP0006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lierne.Abstractions\Lierne.Abstractions.csproj" />
    <ProjectReference Include="..\Lierne.Core\Lierne.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lierne.Components.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalFlare)' != 'true'">
    <PackageReference Include="Flare.Components.IDE" />
  </ItemGroup>

  <PropertyGroup Condition="'$(UseLocalFlare)' == 'true' And Exists('$(FlareRoot)\src\Flare.Components.IDE\Components\FlareSettings.razor')">
    <DefineConstants>$(DefineConstants);LIERNE_FLARE_SETTINGS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalFlare)' == 'true'">
    <ProjectReference Include="$(FlareRoot)\src\Flare.Components.IDE\Flare.Components.IDE.csproj"
                      GlobalPropertiesToRemove="BuildingSolutionFile;CurrentSolutionConfigurationContents" />
  </ItemGroup>
</Project>
