<Project>
  <!--
    Pass -p:UseLocalFlare=true for a single build, or copy this file to Directory.Build.local.props
    to enable it for every build on this machine.

    FlareRoot defaults to the sibling ..\Flare checkout; set it explicitly when Flare lives
    somewhere else. UseLocalFlare=true swaps the Flare PackageReference entries in
    Lierne, the component tests, and SampleIde for ProjectReference entries.
  -->
  <PropertyGroup>
    <UseLocalFlare>true</UseLocalFlare>
  </PropertyGroup>
</Project>
