@inject ILierneLocalizer Text

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>@Text.Get(NotesPlugin.Text("app"))</title>
    <script src="_content/Flare.Components/js/flare-bootstrap.js" data-default-theme="visualstudio"></script>
    <link rel="stylesheet" href="_content/Flare.Components/css/flare-components.css" />
    <link rel="stylesheet" href="_content/Flare.Components.IDE/css/flare-ide.css" />
    <style>html, body, .flare-root { height: 100%; margin: 0; }</style>
</head>
<body>
    <Router AppAssembly="typeof(App).Assembly">
        <Found Context="route">
            <RouteView RouteData="@route" />
        </Found>
    </Router>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
