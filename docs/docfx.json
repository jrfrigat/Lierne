{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "Lierne.Abstractions/bin/Release/net11.0/Lierne.Abstractions.dll",
            "Lierne.Core/bin/Release/net11.0/Lierne.Core.dll",
            "Lierne/bin/Release/net11.0/Lierne.dll"
          ]
        }
      ],
      "dest": "api",
      "outputFormat": "mref"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["index.md", "toc.yml", "articles/**.md", "articles/**/toc.yml", "api/**.yml", "api/index.md"]
      }
    ],
    "resource": [
      {
        "src": "../assets",
        "files": ["logo.svg", "banner.svg"],
        "dest": "assets"
      }
    ],
    "output": "_site",
    "template": ["default", "modern", "template"],
    "globalMetadata": {
      "_appName": "Lierne",
      "_appTitle": "Lierne",
      "_appLogoPath": "assets/logo.svg",
      "_appFaviconPath": "assets/logo.svg",
      "_enableSearch": true,
      "_disableContribution": true
    },
    "postProcessors": ["ExtractSearchIndex"]
  }
}
